# ── ESP-IDF build output ──
# Everything here is regenerated by `idf.py build`. Committing it bloats the
# repository with megabytes that change on every build and merge badly.
build/
managed_components/

# The resolved config is generated from sdkconfig.defaults on first build and
# picks up local paths and toolchain details. sdkconfig.defaults is committed
# instead, so every clone builds the same way.
sdkconfig
sdkconfig.old

# dependencies.lock IS committed on purpose: it pins the component versions a
# build was verified against.

# ── Editor and OS ──
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# ── Local helper scripts ──
# Build and flash wrappers hard-code one machine's IDF path and serial port.
# Use `idf.py build` and `idf.py -p <PORT> flash` instead.
*.bat
*.ps1

# ── Never commit ──
# Credentials belong in NVS on the device, entered through the setup wizard,
# never in the source tree. See README section 7.
secrets.*
*.pem
*.key
